# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Create a key with:  keytool -genkeypair -v -keystore rawvision.jks -alias rawvision -keyalg RSA -keysize 2048 -validity 10000
storeFile=rawvision.jks
storePassword=CHANGE_ME
keyAlias=rawvision
keyPassword=CHANGE_ME
